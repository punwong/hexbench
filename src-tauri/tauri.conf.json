    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2MkFFRjlCQTNBODExNjgKUldSb0VhaWptKzhxcGxoZEFhclU3WjZHY21pMlZOSWwzVkxTVnZuUDlQMUtyZ3lzZmMwRjF3dlcK",
      "endpoints": [
        "https://github.com/punwong/hexbench/releases/latest/download/latest.json"
